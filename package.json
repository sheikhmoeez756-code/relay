{
  "name": "relay-bpo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "test:integration": "cross-env RUN_DB_TESTS=1 vitest run tests/integration.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset-demo": "tsx scripts/reset-demo.ts && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "lucide-react": "^0.468.0",
    "next": "^15.5.12",
    "next-auth": "^4.24.11",
    "nodemailer": "10.0.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "recharts": "^3.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/smtp-server": "^3.5.13",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "18.4.0-beta.17",
    "postcss": "8.5.28",
    "prettier": "^3.9.9",
    "prisma": "^6.19.0",
    "smtp-server": "^3.19.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "5.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "8.0.2",
    "nodemailer": "$nodemailer"
  }
}
